# --- AI provider ---
# Primary provider. Only "gemini" is implemented today.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-flash-lite-latest —
# verified against our exact schema/prompt/parsing path (structured output,
# CTA/reward extraction) before being made the default; chosen because this
# app's workload (extraction, summarization, structured JSON, short
# explanations) doesn't need a larger model, and Lite has historically had
# its own separate free-tier quota pool from the standard Flash tier.
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: a second registered provider name to fall back to when the
# primary fails. No-op until a second provider is actually implemented.
# AI_FALLBACK_PROVIDER=
# Falling back on daily quota exhaustion specifically requires explicit opt-in
# (a different provider's quota is unrelated to the primary's, but this can
# double AI spend if left on by accident):
# AI_FALLBACK_ON_QUOTA=true

# --- Rate limiting ---
# "memory" (default): single-process only, fine for local dev and a single
#   long-running server instance. Does NOT share state across multiple
#   instances/regions/serverless invocations.
# "redis": distributed, atomic, shared across every instance. Requires an
#   Upstash Redis database (free tier is fine) — https://console.upstash.com
RATE_LIMIT_BACKEND=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# The same Upstash Redis database above (if configured) is also reused as a
# cache for the resource-finder pipeline (ingested-reel signals and resolver
# search results, both with TTLs) to cut repeat AI/API cost. Purely an
# optimization — every cache read/write is wrapped in try/catch and no-ops
# if Redis isn't configured, so the pipeline works with or without it.

# --- Stage A ingestion: optional self-hosted/third-party extractor ---
# Instagram has no official API for reel video, audio, or on-screen text.
# This app does NOT bundle or host a scraper/extractor itself (see README's
# "Instagram ToS and scraping risk" section). If you run your own extractor
# service (e.g. a yt-dlp-based worker you host and are legally responsible
# for) that returns transcript/OCR/on-screen-text signals, point this at it;
# otherwise the pipeline falls back to oEmbed/OG-tag metadata and whatever
# the user pastes manually (caption/transcript/comments/on-screen text).
# EXTRACTOR_API_URL=
# EXTRACTOR_API_KEY=

# --- Identify your server to the free public APIs this app calls ---
# Wikimedia (Wikidata) and OpenStreetMap (Nominatim) ask API clients to put
# contact details in their User-Agent and throttle anonymous generic clients
# harder. An email address or a URL to your project is enough.
# OPERATOR_CONTACT=

# --- Stage C resolvers: optional API keys ---
# Every resolver below is skipped gracefully (with a warning surfaced in the
# response, never a crash) if its key is absent. The following resolvers are
# keyless and always active: GitHub, npm, Open Library (books), arXiv
# (papers), OpenStreetMap/Nominatim (places), iTunes Search (mobile apps),
# Wikidata (official websites of well-known tools and apps).

# Effectively required in production. Unauthenticated GitHub search is capped
# at 10 requests/minute per IP, and serverless platforms share egress IPs, so
# without a token that budget is routinely exhausted — every GitHub/package
# lookup then fails (the response says "GitHub search is rate-limited"). A
# token raises it to 30/min per token. No scopes are needed for public search.
# GITHUB_TOKEN=

# Activates the YouTube resolver (video/channel/playlist pointers). Get a key
# from https://console.cloud.google.com (enable "YouTube Data API v3").
# YOUTUBE_API_KEY=

# Activates the universal web-search fallback resolver, used for any
# resourceType not covered by a dedicated resolver (e.g. products, courses,
# jobs, social accounts, PyPI packages). Get a key from https://tavily.com.
# TAVILY_API_KEY=
